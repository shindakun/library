# Secrets: Adobe activation + decryption keys. NEVER commit.
/secrets/*
!/secrets/.gitkeep
# Any backup/copy of the secrets dir (activation.xml, device.xml, devicesalt, keys).
secrets.bak/
secrets*.bak/
*.bak/

# Loan/purchase tokens and any books: local only.
*.acsm
*.epub
*.pdf
*.der

# Library data (the library dir, db, import staging)
/data/library/*
!/data/library/.gitkeep
/data/import/**
/data/catalog.db*
/data/covers/

# Build artifacts
/library
/bin/
*.test

# Stray downloads / installers that shouldn't be committed
*.dmg
*.pkg

# This project has NO Node deps (frontend JS is vendored). Backstop against any
# stray tooling dropping node_modules into the repo.
/node_modules/
package.json
package-lock.json

# OS / editor
.DS_Store
